<div class="marquee">
  <div class="marquee__track">
    {%- for i in (1..3) -%}
      <div class="marquee__group" aria-hidden="{% unless forloop.first %}true{% else %}false{% endunless %}">
        {%- for block in section.blocks -%}
          <span {% if forloop.parentloop.first %}{{ block.shopify_attributes }}{% endif %}>{{ block.settings.text }}</span>
          {%- unless forloop.last -%}<span class="marquee__dot">✦</span>{%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "settings": [],
  "blocks": [
    {
      "type": "text",
      "name": "t:sections.announcement-bar.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.announcement-bar.blocks.text.settings.text",
          "default": "Numbered edition"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        { "type": "text", "settings": { "text": "Numbered edition" } },
        { "type": "text", "settings": { "text": "Free shipping over $75" } },
        { "type": "text", "settings": { "text": "Heavyweight brushed fleece" } },
        { "type": "text", "settings": { "text": "Restocks never" } }
      ]
    }
  ]
}
{% endschema %}
