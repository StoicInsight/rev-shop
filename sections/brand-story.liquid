<div class="brand-story">
  <svg class="brand-story__rings" viewBox="0 0 400 400" aria-hidden="true">
    <circle cx="200" cy="200" r="160" fill="none" stroke="rgba(var(--color-accent), .35)" stroke-width="1"></circle>
    <circle cx="200" cy="200" r="118" fill="rgb(var(--color-border))"></circle>
    <circle cx="242" cy="172" r="100" fill="rgb(var(--color-surface))"></circle>
  </svg>
  <div class="dot-field" aria-hidden="true"></div>

  <div class="page-width brand-story__grid">
    <div class="brand-story__text">
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="font-heading brand-story__heading">
        {{ section.settings.heading }} <span class="italic-accent">{{ section.settings.heading_italic }}</span>
      </h2>
      {%- if section.settings.body != blank -%}
        <p class="brand-story__body">{{ section.settings.body }}</p>
      {%- endif -%}
      {%- if section.settings.body_secondary != blank -%}
        <p class="brand-story__body brand-story__body--muted">{{ section.settings.body_secondary }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="brand-story__stats">
          {%- for block in section.blocks -%}
            <div class="brand-story__stat" {{ block.shopify_attributes }}>
              <div class="font-heading brand-story__stat-number">{{ block.settings.number }}</div>
              <div class="font-accent brand-story__stat-label">{{ block.settings.label }}</div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="brand-story__media">
      <div class="brand-story__media-pattern" aria-hidden="true"></div>
      {%- if section.settings.image -%}
        <img
          src="{{ section.settings.image | image_url: width: 900 }}"
          srcset="{{ section.settings.image | image_url: width: 500 }} 500w, {{ section.settings.image | image_url: width: 900 }} 900w"
          sizes="(min-width: 700px) 45vw, 90vw"
          alt="{{ section.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'brand-story__placeholder' }}
      {%- endif -%}
      {%- if section.settings.image_caption != blank -%}
        <div class="brand-story__media-caption font-accent">{{ section.settings.image_caption }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.brand-story.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.brand-story.settings.eyebrow",
      "default": "About the drop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.brand-story.settings.heading",
      "default": "The House of"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "t:sections.brand-story.settings.heading_italic",
      "default": "Dreamers"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:sections.brand-story.settings.body",
      "default": "Rêveur was built around one idea: the dream comes first, and everything after it is work. The crescent stands for the hours nobody watches. Both go on a piece heavy enough to last as long as the ambition does."
    },
    {
      "type": "textarea",
      "id": "body_secondary",
      "label": "t:sections.brand-story.settings.body_secondary",
      "default": "Drop 01 is cut from heavyweight brushed-back fleece, printed in silver and white, released in limited runs and numbered by hand. When it's gone, it's gone."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.brand-story.settings.image"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "t:sections.brand-story.settings.image_caption",
      "default": "Crest Crewneck — Dreams · Passion · Victory"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "t:sections.brand-story.blocks.stat.name",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "t:sections.brand-story.blocks.stat.settings.number",
          "default": "500"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.brand-story.blocks.stat.settings.label",
          "default": "Per style"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.brand-story.presets.name",
      "blocks": [
        { "type": "stat", "settings": { "number": "500", "label": "Per style" } },
        { "type": "stat", "settings": { "number": "380", "label": "GSM fleece" } },
        { "type": "stat", "settings": { "number": "01", "label": "Drop number" } }
      ]
    }
  ]
}
{% endschema %}
