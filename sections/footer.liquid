<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__top">
      <div class="site-footer__newsletter">
        <h3 class="font-heading site-footer__newsletter-heading">
          {{ section.settings.newsletter_heading }}
          <span class="italic-accent">{{ section.settings.newsletter_heading_italic }}</span>
        </h3>

        {%- assign newsletter_form_id = 'NewsletterForm' -%}
        {% form 'customer', id: newsletter_form_id, class: 'site-footer__newsletter-form-wrap' %}
          {%- if form.posted_successfully? -%}
            <div class="form-success">
              {{ 'general.newsletter.success' | t }}
            </div>
          {%- else -%}
            <p class="site-footer__newsletter-body">{{ section.settings.newsletter_body }}</p>
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="site-footer__newsletter-field" data-newsletter-form data-error-message="{{ 'general.newsletter.error' | t }}">
              <input
                type="email"
                name="contact[email]"
                id="NewsletterEmail"
                class="site-footer__newsletter-input"
                placeholder="{{ 'general.newsletter.email_placeholder' | t }}"
                required
              >
              <button type="submit" class="btn btn-primary btn-small">{{ 'general.newsletter.submit' | t }}</button>
            </div>
            {%- if form.errors -%}
              <div class="form-error">{{ form.errors.messages['contact[email]'] | default: 'general.newsletter.error' | t }}</div>
            {%- endif -%}
          {%- endif -%}
        {% endform %}
      </div>

      <div class="site-footer__menus">
        {%- for block in section.blocks -%}
          {%- if block.type == 'link_list' -%}
            <div class="site-footer__menu" {{ block.shopify_attributes }}>
              <div class="font-accent site-footer__menu-title">{{ block.settings.title }}</div>
              {%- for link in block.settings.menu.links -%}
                <a href="{{ link.url }}" class="site-footer__menu-link">{{ link.title }}</a>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="site-footer__bottom">
      <div class="site-footer__brand">
        {% render 'icon', name: 'logo-mark', width: 18, height: 18, color_a: 'rgb(var(--color-accent))', color_b: 'rgb(var(--color-surface))' %}
        <span class="font-heading site-footer__brand-name">{{ settings.logo_wordmark | default: shop.name }}</span>
        <span class="font-accent site-footer__copyright">© {{ 'now' | date: '%Y' }}</span>
      </div>

      {%- assign has_social = false -%}
      {%- if settings.social_instagram_link != blank or settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_tiktok_link != blank -%}
        {%- assign has_social = true -%}
      {%- endif -%}

      {%- if has_social -%}
        <div class="site-footer__social">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" class="site-footer__social-link" aria-label="{{ 'general.social.follow_on' | t: name: 'Instagram' }}" target="_blank" rel="noopener">
              {% render 'icon', name: 'instagram', width: 14, height: 14 %}
            </a>
          {%- endif -%}
          {%- if settings.social_twitter_link != blank -%}
            <a href="{{ settings.social_twitter_link }}" class="site-footer__social-link" aria-label="{{ 'general.social.follow_on' | t: name: 'Twitter' }}" target="_blank" rel="noopener">
              {% render 'icon', name: 'twitter', width: 14, height: 14 %}
            </a>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" class="site-footer__social-link" aria-label="{{ 'general.social.follow_on' | t: name: 'Facebook' }}" target="_blank" rel="noopener">
              {% render 'icon', name: 'facebook', width: 14, height: 14 %}
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}" class="site-footer__social-link" aria-label="{{ 'general.social.follow_on' | t: name: 'TikTok' }}" target="_blank" rel="noopener">
              {% render 'icon', name: 'tiktok', width: 14, height: 14 %}
            </a>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="site-footer__social">
          <span class="site-footer__social-link">
            {% render 'icon', name: 'mail', width: 14, height: 14 %}
          </span>
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:sections.footer.settings.newsletter_heading",
      "default": "Join the"
    },
    {
      "type": "text",
      "id": "newsletter_heading_italic",
      "label": "t:sections.footer.settings.newsletter_heading_italic",
      "default": "House"
    },
    {
      "type": "textarea",
      "id": "newsletter_body",
      "label": "t:sections.footer.settings.newsletter_body",
      "default": "Early access to drops and restock alerts. Nothing else."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.footer.blocks.link_list.settings.title",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.link_list.settings.menu"
        }
      ]
    }
  ]
}
{% endschema %}
