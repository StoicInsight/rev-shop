<div class="section-pad account-section">
  <div class="page-width">
    <div class="section-head">
      <h1 class="font-heading section-head__title">{{ 'customer.account.title' | t }}</h1>
      <div class="section-head__meta">
        <a href="{{ routes.account_addresses_url }}" class="underline-link">{{ 'customer.account.view_addresses' | t }}</a>
        <a href="{{ routes.account_logout_url }}" class="underline-link">{{ 'customer.log_out' | t }}</a>
      </div>
    </div>

    <h2 class="font-heading account-orders__title">{{ 'customer.orders.title' | t }}</h2>

    {%- if customer.orders.size > 0 -%}
      <div class="account-orders">
        {%- for order in customer.orders -%}
          <a href="{{ order.customer_url }}" class="account-order-row">
            <span class="font-accent">{{ order.name }}</span>
            <span class="font-accent">{{ order.created_at | date: '%B %d, %Y' }}</span>
            <span class="font-accent">{{ order.financial_status_label }}</span>
            <span class="font-accent">{{ order.fulfillment_status_label }}</span>
            <span class="font-accent account-order-row__total">{{ order.total_price | money }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="account-orders__empty">{{ 'customer.orders.none' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
