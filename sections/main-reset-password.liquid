<div class="section-pad account-section">
  <div class="page-width account-narrow">
    <div class="account-panel">
      <h1 class="font-heading account-panel__title">{{ 'customer.reset_password.title' | t }}</h1>
      <p class="account-panel__hint">{{ 'customer.reset_password.subtext' | t }}</p>

      {% form 'reset_customer_password' %}
        {%- if form.errors -%}
          <div class="form-error">{{ form.errors.messages.first }}</div>
        {%- endif -%}

        <div class="account-field">
          <label class="font-accent account-label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
          <input class="field" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
        </div>
        <div class="account-field">
          <label class="font-accent account-label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
          <input class="field" type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
        </div>
        <button type="submit" class="btn btn-primary btn-block">{{ 'customer.reset_password.submit' | t }}</button>
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
