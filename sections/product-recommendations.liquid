<div id="ProductRecommendations">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="section-pad section-pad--tight">
      <div class="page-width">
        <div class="section-head">
          <h2 class="font-heading section-head__title">
            {{ section.settings.heading }} <span class="italic-accent">{{ section.settings.heading_italic }}</span>
          </h2>
        </div>
        <div class="product-grid" style="--columns-desktop: {{ section.settings.columns_desktop }};">
          {%- for product in recommendations.products -%}
            {% render 'product-card', product: product, index: forloop.index %}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.product-recommendations.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading — italic word",
      "default": "like"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    }
  ]
}
{% endschema %}
