<div class="predictive-search" id="PredictiveSearch" data-predictive-search hidden>
  <div class="predictive-search__overlay" data-search-close></div>
  <div class="predictive-search__panel" role="dialog" aria-modal="true" aria-label="{{ 'accessibility.search' | t }}">
    <form action="{{ routes.search_url }}" method="get" role="search" class="predictive-search__form" data-search-form>
      {% render 'icon', name: 'search', width: 18, height: 18 %}
      <input
        type="search"
        name="q"
        value=""
        placeholder="{{ 'general.search.placeholder' | t }}"
        class="predictive-search__input"
        autocomplete="off"
        data-search-input
      >
      <input type="hidden" name="type" value="product">
      <button type="button" class="site-header__icon-btn" data-search-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon', name: 'close', width: 18, height: 18 %}
      </button>
    </form>

    <div class="predictive-search__results" data-search-results aria-live="polite"></div>
  </div>
</div>
