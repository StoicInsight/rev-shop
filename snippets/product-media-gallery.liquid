<div class="product-gallery" data-product-gallery>
  <div class="product-gallery__main">
    <span class="dot-field" aria-hidden="true"></span>
    {%- if product.media.size > 0 -%}
      {%- for media in product.media -%}
        <img
          src="{{ media | image_url: width: 1200 }}"
          srcset="{{ media | image_url: width: 700 }} 700w, {{ media | image_url: width: 1200 }} 1200w"
          sizes="(min-width: 900px) 45vw, 100vw"
          alt="{{ media.alt | default: product.title | escape }}"
          class="product-gallery__image{% unless forloop.first %} is-hidden{% endunless %}"
          data-gallery-image
          data-media-id="{{ media.id }}"
          loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          width="{{ media.width }}"
          height="{{ media.height }}"
        >
      {%- endfor -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'product-gallery__placeholder' }}
    {%- endif -%}
  </div>

  {%- if product.media.size > 1 -%}
    <div class="product-gallery__thumbs">
      {%- for media in product.media -%}
        <button
          type="button"
          class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
          data-gallery-thumb
          data-media-id="{{ media.id }}"
          aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"
        >
          <img src="{{ media | image_url: width: 200 }}" alt="" loading="lazy" width="100" height="100">
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
